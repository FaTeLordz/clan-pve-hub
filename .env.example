# ==========================================
# CALL OF DUTY ZOMBIES CLAN HUB CONFIGURATION
# ==========================================

# Port the Web Leaderboard runs on
PORT=3000

# Discord Bot Token (Get this from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Application Client ID
DISCORD_CLIENT_ID=your_client_id_here

# (Optional) Specific Discord Server / Guild ID
# If set, slash commands register instantly to this server instead of taking 1 hr globally
DISCORD_GUILD_ID=

# Discord Channel ID where admin approval embeds & buttons will appear (e.g. #mod-review)
ADMIN_CHANNEL_ID=

# (Optional) Discord Channel ID where newly approved records get shouted out to the clan (e.g. #announcements)
PUBLIC_ANNOUNCE_CHANNEL_ID=
